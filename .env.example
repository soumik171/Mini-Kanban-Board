# PostgreSQL
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_dev_password
POSTGRES_DB=kanban

# Backend
DATABASE_URL=postgresql://kanban:kanban_dev_password@localhost:5432/kanban?schema=public
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
# Rate limiting (requests per 15 minutes per IP)
AUTH_RATE_LIMIT_MAX=100
API_RATE_LIMIT_MAX=1000
# Set to 1 when deployed behind a reverse proxy (nginx, Fly, Render, ...)
TRUST_PROXY=0
